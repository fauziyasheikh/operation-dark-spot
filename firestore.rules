rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'avatar', 'xp', 'badges', 'casesClosed']) &&
             data.displayName is string &&
             data.displayName.size() >= 2 &&
             data.displayName.size() <= 30 &&
             data.avatar is string &&
             data.avatar.size() <= 20 &&
             data.xp is number &&
             data.badges is list &&
             data.badges.size() <= 100 &&
             data.casesClosed is number;
    }

    // A user can read and write only their own users/{uid} data
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Disallow querying all users
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
